[Unit]
Description=Loy Krathong 2569 API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/loykrathong26
Environment=PORT=3026
Environment=DB_PATH=/var/lib/loykrathong26/krathong.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/server.mjs
Restart=always

[Install]
WantedBy=multi-user.target
